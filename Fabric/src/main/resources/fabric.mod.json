{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${authors}"
  ],
  "contact": {
    "homepage": "${displayURL}",
    "sources": "${sources}",
    "issues": "${issueTrackerURL}"
  },
  "license": "${license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "darkorg.lightconfig.fabric.LightConfigFabric"
    ],
    "client": [
      "darkorg.lightconfig.fabric.LightConfigFabricClient"
    ],
    "server": [
      "darkorg.lightconfig.fabric.LightConfigFabricServer"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": ">=${minecraft_version} <1.21",
    "java": ">=17"
  }
}